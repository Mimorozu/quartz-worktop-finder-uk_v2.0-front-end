generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                Int                @id(map: "idx_16400_primary") @default(autoincrement())
  companyName       String             @map("company_name") @db.VarChar(255)
  contactName       String?            @map("contact_name") @db.VarChar(255)
  phone             String             @db.VarChar(20)
  email             String?            @db.VarChar(255)
  website           String?            @db.VarChar(255)
  addressLine1      String?            @map("address_line1") @db.VarChar(255)
  addressLine2      String?            @map("address_line2") @db.VarChar(255)
  city              String?            @db.VarChar(100)
  county            String?            @db.VarChar(100)
  postcode          String?            @db.VarChar(10)
  coverage_area     String?
  description       String?
  services_offered  String?
  logo_url          String?            @db.VarChar(255)
  featured          Boolean?           @default(false)
  active            Boolean?           @default(true)
  dateAdded         DateTime           @default(now()) @map("date_added") @db.Timestamptz(6)
  lastUpdated       DateTime?          @updatedAt @map("last_updated") @db.Timestamptz(6)
  coveragePostcodes CoveragePostcode[]
  websiteClicks     WebsiteClick[]

  @@map("companies")
}

model CoveragePostcode {
  id           Int     @id(map: "idx_16414_primary") @default(autoincrement())
  companyId    Int     @map("company_id")
  postcodeArea String  @map("postcode_area") @db.VarChar(10)
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "coverage_postcodes_ibfk_1")

  @@index([companyId], map: "idx_16414_company_id")
  @@index([postcodeArea], map: "idx_16414_postcode_area")
  @@map("coverage_postcodes")
}

model WebsiteClick {
  id           Int                          @id(map: "idx_16422_primary") @default(autoincrement())
  companyId    Int                          @map("company_id")
  clickType    ClickType?                   @default(website) @map("click_type")
  clickedAt    DateTime                     @default(now()) @map("clicked_at") @db.Timestamptz(6)
  userIp       String?                      @map("user_ip") @db.VarChar(45)
  userPostcode String?                      @map("user_postcode") @db.VarChar(10)
  company      Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "website_clicks_ibfk_1")

  @@index([clickedAt], map: "idx_16422_clicked_at")
  @@index([companyId], map: "idx_16422_company_id")
  @@map("website_clicks")
}

enum ClickType {
  contact_reveal
  website
  phone
  email

  @@map("website_clicks_click_type_t")
}

model SearchUnlock {
  id              Int          @id @default(autoincrement())
  postcode        String       @db.VarChar(10)
  postcodeArea    String       @map("postcode_area") @db.VarChar(10)
  amount          Int
  currency        String       @default("gbp") @db.VarChar(3)
  status          UnlockStatus @default(pending)
  stripeSessionId String       @unique @map("stripe_session_id") @db.VarChar(255)
  userIp          String?      @map("user_ip") @db.VarChar(45)
  paidAt          DateTime?    @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([postcodeArea], map: "idx_search_unlocks_postcode_area")
  @@map("search_unlocks")
}

enum UnlockStatus {
  pending
  paid
  expired

  @@map("search_unlocks_status_t")
}
